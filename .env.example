# Токен бота від @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Як часто перевіряти підписки (у хвилинах)
CHECK_INTERVAL_MINUTES=5

# Скільки нових оголошень надсилати за одну перевірку (захист від флуду)
MAX_ADS_PER_CHECK=10

# Скільки сторінок видачі OLX обходити за одну перевірку (кожна сторінка —
# окремий HTTP-запит; на широких пошуках оголошень може бути кілька сотень)
MAX_PAGES=5

# Таймаут HTTP-запитів до OLX (секунди)
REQUEST_TIMEOUT=15

# Шлях до файлу бази даних SQLite
DB_PATH=data/olx_bot.db

# --- Потрібно лише для запуску через web.py (webhook-режим, напр. на Render) ---
# Публічна адреса сервісу. На Render можна не задавати — підставляється
# автоматично зі змінної RENDER_EXTERNAL_URL.
WEBHOOK_URL=

# Секрет для перевірки, що запити на /webhook справді від Telegram.
# Згенеруйте випадковий рядок, напр.: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# Порт, на якому слухає aiohttp-сервер. Render підставляє свій PORT автоматично.
PORT=8080
